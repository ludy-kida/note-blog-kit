{
  "name": "note-blog-kit-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -C packages/note-blog-kit build",
    "build:examples": "node scripts/build-examples.mjs",
    "api": "pnpm -C packages/note-blog-kit api",
    "api:check": "pnpm -C packages/note-blog-kit api:check",
    "size": "pnpm -C packages/note-blog-kit size",
    "check:dist": "pnpm -C packages/note-blog-kit check:dist",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm size && pnpm api:check && pnpm check:dist",
    "changeset": "changeset",
    "fixtures:plan": "node scripts/record-fixtures.ts --dry-run",
    "fixtures:record": "node scripts/record-fixtures.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.7",
    "@changesets/cli": "^3.0.3",
    "@microsoft/api-extractor": "^7.60.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
