          "disableGuestPurchase": false,
          "likeAppealText": "スキありがとうございます。",
          "likeAppealImage": "https://assets.st-note.com/production/uploads/images/237125470/a67ad4bba8654251d89e3b959ca6f114.png?fit=bounds&format=jpeg&height=500&quality=85&width=500",
